# =============================================================================
# Note Taker — Environment Configuration
# =============================================================================
#
# This app is BYOK (Bring Your Own Keys). All user credentials — Zoom login,
# Notion API key, and LLM API key — are sent at runtime via the browser vault
# and stored only in volatile RAM (zero persistent storage). Do NOT put user
# API keys in this file.
#
# The vars below are deployment-level settings only.
# =============================================================================

# NODE_ENV: Controls server mode.
#   - Unset or "development": Vite dev middleware with HMR
#   - "production": Serves pre-built static files from dist/
# NODE_ENV=production

# PORT: Override the default port (3000). Rarely needed.
# PORT=3000
